{
  "compilerOptions": {
    "strict": true, "target": "ES2023", "lib": ["ES2023"],
    "module": "nodenext", "moduleResolution": "nodenext",
    "noEmit": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [".", "../shared/types.ts"],
  "exclude": ["src/web"]
}
