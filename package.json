{
  "name": "code-doc-assistant",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:db": "node --env-file=.env node_modules/.bin/vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "ingest": "tsx --env-file=.env src/ingest/cli.ts",
    "migrate": "node --env-file=.env node_modules/.bin/node-pg-migrate up",
    "serve": "tsx --env-file=.env src/server/index.ts",
    "dev:server": "tsx watch --env-file=.env src/server/index.ts",
    "dev:web": "vite --config src/web/vite.config.ts --host 0.0.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  }
}
