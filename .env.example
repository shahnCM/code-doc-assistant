# Copy to .env and fill in GEMINI_API_KEY, then: docker compose up
#
# DATABASE_URL here uses the compose network's service name (`postgres`), not `postgres-16` —
# that hostname is specific to the maintainer's own dev container, not this compose file.
DATABASE_URL=postgres://admin:admin@postgres:5432/codedocs
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-2
GEN_MODEL=gemini-3.6-flash
PORT=8080
